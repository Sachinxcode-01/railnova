# RailNova Environment Configuration (Template)
# Copy this file to .env.local and fill in your values. Never commit .env.local.

# Session signing secret (generate a strong 32+ char random string in production)
RAILNOVA_SESSION_SECRET=replace-with-strong-random-secret-at-least-32-chars

# Optional: RailKit Live Indian Railways SDK (https://railkit.in)
# When set, /api/trains, /api/live, and /api/pnr/[pnr] query live feeds server-side
# and fall back to local demonstration data if unavailable.
RAILKIT_API_KEY=
RAILWAY_API_KEY=
RAILWAY_API_HOST=

# Optional: PostgreSQL / Supabase (if migrating from local JSON persistence)
DATABASE_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional: Razorpay Test/Live Mode Keys
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Optional: AI Assistant (Nova AI uses deterministic railway intelligence if unset)
OPENROUTER_API_KEY=
GEMINI_API_KEY=

# Public App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional: Google Analytics 4
NEXT_PUBLIC_GA_ID=
